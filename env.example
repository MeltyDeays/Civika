# Copiar a .env.local en la raíz del proyecto.
# Nunca subas .env.local al repositorio.

# --- Supabase ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# --- Groq (IA: reportes, sugerencias, moderación) ---
# Varias claves separadas por coma = pool con rotación automática
VITE_GROQ_API_KEY=gsk_key1,gsk_key2
VITE_GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_API_KEYS=gsk_key1,gsk_key2

# --- Biometría (proxy Vite → Spring Boot local) ---
VITE_BIOMETRIC_API_URL=/api/biometric
