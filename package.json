{
  "name": "civicreports",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node scripts/run-backend.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "repomix:changed": "node -e \"const { execSync } = require('child_process'); const files = execSync('git -c core.safecrlf=false diff --name-only HEAD').toString().trim().split(/\\r?\\n/).map(f => f.trim()).filter(Boolean).join(','); if (files) execSync('npx repomix --include ' + files, { stdio: 'inherit' }); else console.log('No changed files to pack.');\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@google/stitch-sdk": "^0.3.5",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.99.3",
    "ai": "^6.0.191",
    "docx": "^9.7.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "pg": "^8.21.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "repomix": "^1.14.1",
    "rtk": "^4.2.0",
    "rtx": "^0.0.4",
    "sharp": "^0.35.1",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "supabase": "^2.98.2",
    "vite": "^8.0.1"
  }
}
